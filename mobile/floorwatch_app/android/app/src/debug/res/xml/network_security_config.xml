<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Dev-PC antivirus (Norton) re-signs HTTPS with its own
     root, which the emulator doesn't trust, so native calls (Firebase
     Installations -> FCM token) fail with "service unavailable". Release
     builds don't include this file. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/dev_proxy_root" />
        </trust-anchors>
    </base-config>
</network-security-config>
