# Floorwatch — deployment configuration template (operational settings only).
#
# Safe to check into version control and edit directly — nothing in this
# file is a secret. Copy to `config/deployment.env` and adjust for your
# site. Real API keys/tokens/connection strings go in secrets.env.template
# instead — see that file and config/README.md for why they're split.
#
# Values here override the code's built-in defaults; anything you don't
# set falls back to the default shown in the comment. Real environment
# variables set by your process manager/OS always take precedence over
# whatever's in this file (see config/README.md "precedence").

# ── Camera / zone bookkeeping ───────────────────────────────────────────
# Floorwatch itself doesn't hold RTSP/ONVIF connection details — those are
# configured in Aegis/DeepCamera (the upstream camera-ingestion platform).
# This is a pointer for your own operational reference only.
# FLOORWATCH_CAMERA_NOTES="See Aegis config for RTSP URLs; Floorwatch only sees camera_id strings"

# ── Redis (event bus) ────────────────────────────────────────────────────
FLOORWATCH_REDIS_URL=redis://localhost:6379/0
FLOORWATCH_REDIS_STREAM=floorwatch:events
FLOORWATCH_REDIS_MOTION_STREAM=floorwatch:motion

# ── Shadow mode (Global Constraint 4 — leave true until go-live checklist passes) ──
FLOORWATCH_SHADOW_MODE=true

# ── Part B — coverage escalation tiers ──────────────────────────────────
FLOORWATCH_NUDGE_TIMER_SECONDS=180
FLOORWATCH_NUDGE_CAP_PER_SHIFT=3
FLOORWATCH_COMMAND_TIMER_SECONDS=300
FLOORWATCH_COMMAND_THROTTLE_PER_HOUR=5
FLOORWATCH_RESOLVE_COOLDOWN_SECONDS=900

# ── Part A — effort tracking ────────────────────────────────────────────
FLOORWATCH_EFFORT_UPDATE_INTERVAL_SECONDS=30
FLOORWATCH_EFFORT_MAX_MOTION_GAP_SECONDS=15
FLOORWATCH_EFFORT_NUDGE_GRACE_RATIO=0.3
FLOORWATCH_EFFORT_NUDGE_MARGIN=0.3

# ── Notifications — CHANNEL CHOICE is operational; the credentials for
#    whichever channel you pick are secrets — see secrets.env.template ──
# none | twilio | fcm
FLOORWATCH_NOTIFY_CHANNEL=none

# ── Embeddings — PROVIDER CHOICE is operational; the API key is a secret ──
# voyage | tfidf  (tfidf needs no key, lower-quality lexical search — fine for a small pilot)
FLOORWATCH_EMBEDDING_PROVIDER=tfidf
FLOORWATCH_VOYAGE_MODEL=voyage-3
FLOORWATCH_EMBEDDING_DIM=512

# ── Vector store — leave FLOORWATCH_POSTGRES_DSN unset here (it contains a
#    password — belongs in secrets.env.template) to use the sqlite fallback,
#    fine at pilot scale (hundreds to low thousands of records).
FLOORWATCH_RULES_ENGINE_URL=http://localhost:8080
FLOORWATCH_ANTHROPIC_MODEL=claude-sonnet-4-5
FLOORWATCH_MAX_TOOL_ITERATIONS=5
FLOORWATCH_RETRIEVAL_TOP_K=5

# ── Auth / session ───────────────────────────────────────────────────────
# FLOORWATCH_AUTH_SECRET is NOT here on purpose — see config/README.md
# "Why AUTH_SECRET is handled separately." Leave it unset to auto-generate
# and persist to services/.floorwatch_auth_secret, or set it explicitly via
# your process manager/secrets store directly (not this file).
FLOORWATCH_TOKEN_TTL_SECONDS=43200

# ── CORS — set to your real dashboard origin(s) before going beyond localhost ──
FLOORWATCH_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8090,http://127.0.0.1:8090

# ── API docs — leave false outside local development ──
FLOORWATCH_DOCS_ENABLED=false

# ── Rate limiting ──
FLOORWATCH_CHAT_RATE_LIMIT_PER_MINUTE=10

# ── Retention — how many days of shift-digest/incident-note/vector-store
#    history to keep before retention.py prunes it (archives before deleting
#    by default; run retention.py on a schedule — see its docstring) ──
FLOORWATCH_RETENTION_DAYS=90

# ── Go-live: employee notice/consent ────────────────────────────────────
# Legal/process attestation, not a technical control — do not treat this
# flag as proof consent was actually obtained (see config/README.md).
# Set to true only after real sign-off from whoever owns that decision at
# your organization. go_live_checklist.py should check this before your
# real deployment disables shadow mode. (Not yet wired into the checklist
# as of this template's creation — flagged in REQUIREMENTS_STATUS.md.)
FLOORWATCH_CONSENT_CONFIRMED=false
