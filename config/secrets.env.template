# Floorwatch — secrets template. DO NOT fill this in and commit it.
#
# Copy to `config/secrets.env`, fill in real values, and make sure that
# copy is never committed (see config/README.md — .gitignore already
# covers config/secrets.env and config/*.env, but double-check before
# your first commit; tools/check_no_secrets.py can scan for accidental
# real values in tracked files).
#
# FLOORWATCH_AUTH_SECRET is deliberately NOT listed here — see
# config/README.md "Why AUTH_SECRET is handled separately." It's the most
# sensitive value in the system (compromise = forge any supervisor login)
# and shouldn't sit in the same file as third-party API keys.

# ── Twilio SMS (only needed if FLOORWATCH_NOTIFY_CHANNEL=twilio) ────────
FLOORWATCH_TWILIO_ACCOUNT_SID=
FLOORWATCH_TWILIO_AUTH_TOKEN=
FLOORWATCH_TWILIO_FROM_NUMBER=

# ── Firebase Cloud Messaging (only needed if FLOORWATCH_NOTIFY_CHANNEL=fcm) ──
# Path to a Firebase service-account JSON file — the file itself is also a
# secret; store it with the same care as this one, outside version control.
FLOORWATCH_FCM_CREDENTIALS_PATH=

# ── Voyage AI embeddings (only needed if FLOORWATCH_EMBEDDING_PROVIDER=voyage) ──
VOYAGE_API_KEY=

# ── Anthropic (chat assistant — required for /api/chat to work at all) ──
ANTHROPIC_API_KEY=

# ── Postgres + pgvector (only needed if you want real Postgres instead of
#    the sqlite fallback — leave blank to use sqlite) ──
# Contains a password if your DSN includes one — treat this line with the
# same sensitivity as a database root password, because it is one.
FLOORWATCH_POSTGRES_DSN=

# ── CCTV source credentials (floorwatch-ingest) ──────────────────────────
# Only fill in the ones your client's cameras.json actually references —
# see skills/detection/floorwatch-ingest/cameras.json.template and
# CCTV_INTEGRATION_SETUP.md. cameras.json itself should only ever contain
# ${VAR_NAME} placeholders, never a real value — ingest.py substitutes
# these in at startup from this file / the real environment.

# AWS S3 — leave both blank to use boto3's default credential chain
# (IAM role, ~/.aws/credentials, etc.) instead, which is preferred over
# static keys for anything beyond a quick local test.
FLOORWATCH_AWS_ACCESS_KEY_ID=
FLOORWATCH_AWS_SECRET_ACCESS_KEY=

# Azure Blob Storage
FLOORWATCH_AZURE_STORAGE_CONNECTION_STRING=

# Google Cloud Storage — path to a service-account JSON key file. The file
# itself is also a secret; store it with the same care as this one.
FLOORWATCH_GCS_CREDENTIALS_PATH=

# Third-party CCTV/surveillance provider API — name(s) depend on which
# provider a given client uses; add one line per token/key their API needs.
# THIRD_PARTY_PROVIDER_API_TOKEN=

# RTSP camera credentials, if not embedded directly in the RTSP URL —
# most NVR/camera RTSP URLs carry user:pass inline instead (see
# cameras.json.template's rtsp example), in which case these are unused.
# FLOORWATCH_RTSP_USERNAME=
# FLOORWATCH_RTSP_PASSWORD=
